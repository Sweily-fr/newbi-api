# Configuration de la base de données
MONGODB_URI=mongodb://localhost:27017/invoice-app

GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Sécurité
JWT_SECRET=your_jwt_secret_key

# Configuration SMTP pour l'envoi d'emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=contact@example.com

# Cles de chiffrement (n'importe quelle chaine, derivee en SHA-256)
SMTP_ENCRYPTION_KEY=your_smtp_encryption_key
CALENDAR_ENCRYPTION_KEY=your_calendar_encryption_key
# Chiffrement AES-256-GCM des données sensibles (IBAN, jetons Pennylane,
# Qonto, réseaux sociaux en direct…)
DATA_ENCRYPTION_KEY=your_data_encryption_key

# URLs
FRONTEND_URL=http://localhost:5173

# Secret partagé avec le frontend (NewbiV2) pour les appels serveur-à-serveur
# (génération PDF des relances/emails). Doit être identique des deux côtés.
INTERNAL_API_SECRET=your_internal_api_secret
# Facultatif, accepté en réception seulement, le temps d'une rotation du
# secret (procédure : docs/rotation-secret-interne.md). Vide = ignoré.
# INTERNAL_API_SECRET_ALT=

# Jeton du back-office newbi-admin (admin.newbi.fr) pour ses écritures
# (/api/admin-service : comptes gestionnaires). Identique à la variable
# ADMIN_SERVICE_TOKEN de newbi-admin. 32 caractères au moins, sinon le
# service est fermé. ADMIN_SERVICE_TOKEN_ALT : accepté pendant une rotation.
# ADMIN_SERVICE_TOKEN=
# ADMIN_SERVICE_TOKEN_ALT=

# Relances de l'essai gratuit (page Relances de newbi-admin) : adresse qui
# reçoit les réponses des clients. Envoi via Resend (RESEND_API_KEY,
# RESEND_FROM_EMAIL), liens de désinscription signés avec BETTER_AUTH_SECRET
# (ou JWT_SECRET) et pointant sur BACKEND_URL.
# TRIAL_NUDGE_REPLY_TO=contact@newbi.fr

# Récap du calendrier le lundi à 8 h (préférence calendar_weekly_digest) :
# absent ou « off » = rien ne part (postes de dev, staging), « simulation » =
# journal calendar_digest_log sans envoi, « live » = envoi réel par Resend.
# Les liens d'abonnement iCal pointent sur BACKEND_URL, jetons chiffrés avec
# CALENDAR_ENCRYPTION_KEY.
# CALENDAR_WEEKLY_DIGEST_MODE=off

# Stripe (paiements)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Configuration du serveur
PORT=4000
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# ==================== CLOUDFLARE R2 CONFIGURATION ====================
# Credentials Cloudflare R2 (partagés pour tous les buckets)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_API_URL=https://your_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your-main-bucket.r2.dev

# --- Bucket: Images utilisateur ---
USER_IMAGE_BUCKET=user
USER_IMAGE_URL=https://pub-your-user-images.r2.dev

# --- Bucket: Images de profil ---
PROFILE_IMAGE_BUCKET=profil
PROFILE_IMAGE_URL=https://pub-your-profile-images.r2.dev

# --- Bucket: Images d'entreprise (logos) ---
COMPANY_IMAGE_BUCKET=image-company
COMPANY_IMAGE_URL=https://pub-your-company-images.r2.dev

# --- Bucket: Signatures mail (images de profil et logos réseaux sociaux) ---
SIGNATURE_BUCKET=image-signature
SIGNATURE_URL=https://pub-your-signature-bucket.r2.dev
# Anciennes adresses publiques de CE bucket, séparées par des virgules (ex.
# l'adresse r2.dev d'avant un domaine personnalisé) : les images enregistrées
# sous l'une d'elles sont rendues sous SIGNATURE_URL. Vide : rien n'est réécrit.
SIGNATURE_LEGACY_URLS=

# --- Bucket: Icônes des signatures v2 (générées à la demande) ---
ICONS_BUCKET=icons
ICONS_URL=https://pub-your-icons-bucket.r2.dev

# --- Bucket: OCR (reçus de dépenses) ---
OCR_BUCKET=ocr
OCR_URL=https://pub-your-ocr-bucket.r2.dev

# --- Bucket: Logos réseaux sociaux ---
LOGO_BUCKET=logo-rs
LOGO_URL=https://pub-your-logo-bucket.r2.dev

# --- Bucket: Transferts de fichiers ---
TRANSFER_BUCKET=app-transfers-prod
TRANSFER_URL=https://pub-your-transfer-bucket.r2.dev

# --- Bucket: Factures émises archivées (PDF Factur-X) — PRIVÉ (URL signée) ---
INVOICES_BUCKET=app-invoices-prod

# --- Buckets: Devis / Avoirs / Bons de commande archivés — PRIVÉS (streaming serveur) ---
QUOTES_BUCKET=app-quotes-prod
CREDIT_NOTES_BUCKET=app-credit-notes-prod
PURCHASE_ORDERS_BUCKET=app-purchase-orders-prod

# ============================================
# FACTURATION ÉLECTRONIQUE — SuperPDP
# ============================================
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=
SUPERPDP_ENVIRONMENT=sandbox          # sandbox | production
# Organisation « système » (connectée à SuperPDP) utilisée pour les consultations
# publiques de l'annuaire (simulateur « Es-tu concerné ? » des LP). Vide = désactivé.
SUPERPDP_DIRECTORY_LOOKUP_ORG_ID=
# Autorise la déconnexion SuperPDP avant la fin de l'engagement d'un an du
# mandat de facturation. Réservé aux tests sandbox (local/staging). Jamais en prod.
# SUPERPDP_ALLOW_EARLY_DISCONNECT=true
# Crons (optionnels — défauts sensés)
# EINVOICE_SYNC_CRON=*/30 * * * *      # suivi des statuts e-invoicing
# RECEPTION_SYNC_CRON=0 * * * *        # import auto des factures reçues
# E-reporting B2C : code de catégorie d'opération (enum imposé par SuperPDP,
# Annexe A norme AFNOR Z12-012). Valeurs valides : TLB1 | TPS1 | TNT1 | TMA1.
# Défaut TPS1 (prestation de services) si non défini. À ajuster selon l'activité.
# EREPORTING_CATEGORY_CODE=TPS1

# Configuration Banking System
BANKING_PROVIDER=mock
DEFAULT_BANKING_PROVIDER=mock
LOG_BANKING_REQUESTS=true

# Bridge API Configuration
BRIDGE_CLIENT_ID=your_bridge_client_id
BRIDGE_CLIENT_SECRET=your_bridge_client_secret
BRIDGE_BASE_URL=https://api.bridgeapi.io
BRIDGE_API_VERSION=v3
BRIDGE_WEBHOOK_SECRET=your_bridge_webhook_secret
BRIDGE_ENVIRONMENT=sandbox
BRIDGE_REDIRECT_URI=http://localhost:3000/banking/callback
# Mobile Universal Link for bank auth callback (must be whitelisted in Bridge dashboard)
BRIDGE_MOBILE_REDIRECT_URI=https://your-domain.com/banking-callback
BACKEND_URL=http://localhost:4000

# Stripe Banking Configuration (différent du Stripe Connect)
STRIPE_BANKING_SECRET_KEY=sk_test_your_stripe_banking_secret_key
STRIPE_BANKING_PUBLISHABLE_KEY=pk_test_your_stripe_banking_publishable_key
STRIPE_BANKING_WEBHOOK_SECRET=whsec_your_stripe_banking_webhook_secret
STRIPE_API_VERSION=2023-10-16

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id


# Mock Provider Configuration (pour les tests)
MOCK_DELAY=1000
MOCK_FAILURE_RATE=0.05

# Configuration Redis pour PubSub (WebSocket subscriptions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== OCR CONFIGURATION ====================
# Provider OCR par défaut: claude-vision, mindee, google-document-ai, mistral-ocr
OCR_PROVIDER=claude-vision

# Désactiver Claude Vision (pour utiliser les autres providers)
# OCR_DISABLE_CLAUDE=true

# Claude Vision API (Anthropic) - Provider par défaut
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_VISION_MODEL=claude-sonnet-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# Mindee OCR (fallback 1) - 250 pages gratuites/mois
MINDEE_API_KEY=your_mindee_api_key

# Google Document AI (fallback 2) - 1000 pages gratuites/mois
GOOGLE_CLOUD_PROJECT_ID=your_project_id
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your_processor_id
GOOGLE_DOCUMENT_AI_LOCATION=eu
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Mistral OCR (fallback 3)
MISTRAL_API_KEY=your_mistral_api_key

# ==================== E-SIGNATURE (OpenAPI) ====================
# Documentation: https://console.openapi.com/apis/esignature/documentation
# Sandbox: https://test.esignature.openapi.com
# Production: https://esignature.openapi.com
ESIGNATURE_API_URL=https://test.esignature.openapi.com
ESIGNATURE_BEARER_TOKEN=your_esignature_oauth_token
ESIGNATURE_WEBHOOK_SECRET=your_esignature_webhook_secret
ESIGNATURE_WEBHOOK_URL=http://localhost:4000/api/esignature/webhook
# Credentials certificat QES (sandbox: openapiSandboxUsername / openapiSandboxPassword)
ESIGNATURE_CERTIFICATE_USERNAME=openapiSandboxUsername
ESIGNATURE_CERTIFICATE_PASSWORD=openapiSandboxPassword

# ==================== QUOTAS OCR PAR PLAN ====================
# Plan par défaut pour les nouveaux utilisateurs
DEFAULT_USER_PLAN=FREE

# Quotas mensuels par plan (configurable)
OCR_QUOTA_FREE=5
OCR_QUOTA_FREELANCE=50
OCR_QUOTA_TPE=200
OCR_QUOTA_ENTREPRISE=1000

# ==================== MINI BACK-OFFICE INTERNE ====================
# Liste CSV des ids utilisateurs autorisés à accéder au back-office
# (/api/backoffice). Fail-closed : vide = back-office désactivé.
BACKOFFICE_ADMIN_USER_IDS=

# Qonto (intégration par clé API, sandbox uniquement via token staging du Developer Portal)
QONTO_STAGING_TOKEN=
# Fréquence du polling Qonto → Newbi (défaut : toutes les 15 min)
QONTO_IMPORT_CRON=*/15 * * * *

# Abby (intégration par clé API, pas de sandbox : compte Abby en mode test)
ABBY_IMPORT_CRON=*/15 * * * *

# Limiteur de débit, par IP et par 15 min (défaut : 1000, et 20 sur /api/auth).
# À relever pour les tests de bout en bout du site, où tout vient de 127.0.0.1.
# RATE_LIMIT_MAX=
# RATE_LIMIT_AUTH_MAX=
# Niveau des journaux (défaut : info en production, debug sinon).
# LOG_LEVEL=

# ==================== RÉSEAUX SOCIAUX (ZERNIO) ====================
# Programmer un post depuis le kanban (Instagram, Facebook, LinkedIn, X,
# TikTok). Une seule clé pour tout Newbi : les clients connectent leurs
# comptes par l'OAuth de Zernio, sans compte ni clé à créer.
# Sans clé, la fonctionnalité est désactivée (aucun crash au démarrage).
ZERNIO_API_KEY=
# Adresse de l'API Zernio (défaut : https://zernio.com/api/v1)
# ZERNIO_API_URL=https://zernio.com/api/v1
# Fréquence du suivi des posts programmés (défaut : toutes les 2 min)
# SOCIAL_POST_SYNC_CRON=*/2 * * * *
# Logo affiché sur l'écran de connexion Zernio (https, défaut : logo Newbi
# carré hébergé sur R2)
# SOCIAL_CONNECT_LOGO_URL=

# ============ RÉSEAUX SOCIAUX : API OFFICIELLES (À CÔTÉ DE ZERNIO) ============
# Fournisseur de chaque réseau pour les connexions neuves : « zernio » (défaut)
# ou « direct » (notre propre appli chez le réseau). Un compte déjà connecté
# garde son fournisseur. Identifiants absents : réseau en direct indisponible,
# sans erreur au démarrage.
# SOCIAL_PROVIDER_FACEBOOK=zernio
# SOCIAL_PROVIDER_INSTAGRAM=zernio
# SOCIAL_PROVIDER_LINKEDIN=zernio
# SOCIAL_PROVIDER_TIKTOK=zernio
# SOCIAL_PROVIDER_TWITTER=zernio
# Espaces passés en direct (identifiants séparés par des virgules ; vide =
# tous) : comptes de relecture Meta / LinkedIn / TikTok sur la prod pendant
# que les clients restent sur Zernio. SOCIAL_DIRECT_WORKSPACE_IDS_<RÉSEAU>
# (FACEBOOK, INSTAGRAM, LINKEDIN, TIKTOK, TWITTER) remplace la liste pour un
# réseau.
# SOCIAL_DIRECT_WORKSPACE_IDS=
# SOCIAL_DIRECT_WORKSPACE_IDS_TIKTOK=
# Fréquence du cron de publication directe (défaut : chaque minute)
# SOCIAL_DIRECT_PUBLISH_CRON=* * * * *
#
# Indispensables au direct :
# - DATA_ENCRYPTION_KEY (chiffrement des jetons, voir en haut du fichier) ;
# - un bucket R2 pour les images des posts (réutilise R2_API_URL,
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY). Les images sont servies par
#   l'API elle-même sous ${NEXT_PUBLIC_API_URL}/social-media/<id>.jpg, sans
#   redirection : api.newbi.fr est couvert par la vérification du domaine
#   newbi.fr chez TikTok (le bucket peut rester privé).
# SOCIAL_MEDIA_BUCKET=social-media-prod
#
# Vidéos des posts : préparées en MP4 H.264 par ffmpeg et ffprobe, fournis
# par les paquets npm ffmpeg-static et @ffprobe-installer/ffprobe (installés
# par npm ci). Facultatif : chemins d'autres binaires à utiliser à la place.
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
#
# Adresses de retour OAuth à déclarer chez chaque réseau :
#   ${NEXT_PUBLIC_API_URL}/social-connect/<réseau>/callback
#   avec <réseau> = facebook | instagram | linkedin | tiktok | twitter
#   (prod : https://api.newbi.fr/..., staging : https://staging-api.newbi.fr/...).
# - X refuse « localhost » : en local, lancer l'API avec
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:4000 et déclarer
#   http://127.0.0.1:4000/social-connect/twitter/callback.
# - TikTok n'accepte que des adresses en HTTPS : pas de connexion TikTok en
#   local sans tunnel HTTPS (tester sur le staging).
#
# Meta, une seule appli (type Business) avec deux produits :
# - Facebook Login for Business (Pages Facebook) : META_APP_ID / META_APP_SECRET ;
#   META_LOGIN_CONFIG_ID = identifiant de la configuration (permissions
#   pages_show_list, pages_read_engagement, pages_manage_posts) ; sans lui,
#   les permissions passent par « scope ».
# - Instagram API with Instagram Login (comptes Instagram professionnels, sans
#   Page liée) : INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET, affichés dans le
#   produit Instagram de la même appli (différents de META_APP_ID).
# META_GRAPH_VERSION épingle la version des deux API (défaut : v26.0).
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# META_GRAPH_VERSION=v26.0
#
# LinkedIn : la Community Management API doit être seule sur son appli,
# d'où deux applis.
# LINKEDIN_CLIENT_ID / SECRET : appli « Share on LinkedIn + Sign In with
# LinkedIn using OpenID Connect », profil perso seulement, sans validation.
# LINKEDIN_PAGES_CLIENT_ID / SECRET : appli « Community Management API »,
# profil + pages entreprise, une fois validée par LinkedIn. Dès qu'elle est
# posée, les connexions neuves passent par elle ; les profils connectés par
# la première appli continuent de publier sans reconnexion (garder ses
# identifiants tant qu'il en reste).
# LINKEDIN_PAGES_WORKSPACE_IDS (virgules, vide = tous) : espaces qui passent
# par l'appli des pages tant que LinkedIn ne l'a pas validée au Standard
# tier (espaces de relecture) ; les autres restent sur l'appli des profils.
# LINKEDIN_API_VERSION épingle l'en-tête Linkedin-Version (AAAAMM, défaut
# 202610 ; une version vit au moins un an).
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_PAGES_CLIENT_ID=
# LINKEDIN_PAGES_CLIENT_SECRET=
# LINKEDIN_PAGES_WORKSPACE_IDS=
# LINKEDIN_API_VERSION=202610
#
# TikTok (Login Kit + Content Posting API). Avant l'audit : posts « Moi
# uniquement » sur compte privé, 5 utilisateurs par 24 h ; la clé de la
# sandbox peut servir pour les espaces de SOCIAL_DIRECT_WORKSPACE_IDS_TIKTOK.
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
#
# X (OAuth 2.0 avec PKCE, client confidentiel). Chaque envoi est facturé à
# Sweily (0,015 $, 0,20 $ avec un lien) : limite mensuelle par offre
# (xPostQuota.js), nouveaux essais automatiques compris.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
